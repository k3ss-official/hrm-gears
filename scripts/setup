#!/usr/bin/env bash
# hrm-gears Door 1 — interactive install.
# TTY: probe, offer to install missing pieces, narrate, pause on gaps.
# --yes: unattended (Door 3 / CI). Non-zero on fail.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

STAGES=6
PASS=()
FAIL=()
SKIP=()
NONINTERACTIVE=0
FORCE_TTY=0
WANT_SUDOKU_ONLY=0
FETCH_SET="all"   # all | sudoku | skip
PYTHON_BIN=""
TOO_OLD_PATH=""
TOO_OLD_VER=""

usage() {
  cat <<'EOF'
Usage: ./setup [options]

  --yes, -y         Unattended. Accept defaults: install Python 3.12 if
                    missing, fetch all three checkpoints, run smokes.
  --sudoku          Sudoku weights + Sudoku smoke only (skip Maze / ARC-2).
  --interactive, -i Force prompts even when stdin is not a TTY.
  -h, --help        Show this help.

On a terminal this is interactive: it tells you what it will run, and
pauses if a prerequisite is missing. Door 3 (Docker) passes --yes.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes|-y) NONINTERACTIVE=1; shift ;;
    --sudoku) WANT_SUDOKU_ONLY=1; FETCH_SET="sudoku"; shift ;;
    --interactive|-i) FORCE_TTY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -t 1 ]]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  RED=$'\033[31m'
  GRN=$'\033[32m'
  YLW=$'\033[33m'
  CYN=$'\033[36m'
  RST=$'\033[0m'
else
  BOLD="" DIM="" RED="" GRN="" YLW="" CYN="" RST=""
fi

# Docker / CI: no prompts unless -i. `docker compose run` often allocates a TTY.
if [[ "$FORCE_TTY" -eq 0 ]]; then
  if [[ -f /.dockerenv ]] || [[ -n "${CI:-}" ]]; then
    NONINTERACTIVE=1
  fi
fi
if [[ "$NONINTERACTIVE" -eq 0 && ! -t 0 && ! -r /dev/tty ]]; then
  NONINTERACTIVE=1
fi

say()  { printf '%s\n' "$*"; }
dim()  { printf '  %s%s%s\n' "$DIM" "$*" "$RST"; }
ok()   { PASS+=("$1"); printf '  %sOK%s   %s\n' "$GRN" "$RST" "$1"; }
warn() { SKIP+=("$1"); printf '  %sSKIP%s %s\n' "$YLW" "$RST" "$1"; }
bad()  { FAIL+=("$1"); printf '  %sFAIL%s %s\n' "$RED" "$RST" "$1"; }

stage() {
  local n="$1" title="$2"
  printf '\n%s[%s/%s]%s %s%s%s\n' "$CYN" "$n" "$STAGES" "$RST" "$BOLD" "$title" "$RST"
}

need_bytes=$((8 * 1024 * 1024 * 1024))
sudoku_bytes=$((600 * 1024 * 1024))  # venv + sudoku ckpt, with headroom

ask_yn() {
  local prompt="$1"
  local default="${2:-Y}"
  local hint ans=""
  if [[ "$default" == [Yy] ]]; then hint="Y/n"; else hint="y/N"; fi
  if [[ "$NONINTERACTIVE" -eq 1 ]]; then
    dim "unattended: $([[ "$default" == [Yy] ]] && echo yes || echo no) — $prompt"
    [[ "$default" == [Yy] ]]
    return
  fi
  if [[ -r /dev/tty ]]; then
    printf '  %s%s%s [%s] ' "$BOLD" "$prompt" "$RST" "$hint" > /dev/tty
    IFS= read -r ans < /dev/tty || ans=""
  else
    [[ "$default" == [Yy] ]]
    return
  fi
  ans="${ans:-$default}"
  [[ "$ans" == [Yy]* ]]
}

ask_choice() {
  # $1 prompt, $2 default, remaining allowed tokens
  local prompt="$1" default="$2"
  shift 2
  local allowed="$*" ans=""
  if [[ "$NONINTERACTIVE" -eq 1 ]]; then
    printf '  %s%s%s\n' "$DIM" "unattended: $default — $prompt" "$RST" >&2
    printf '%s\n' "$default"
    return
  fi
  if [[ -r /dev/tty ]]; then
    printf '  %s%s%s [%s] ' "$BOLD" "$prompt" "$RST" "$default" > /dev/tty
    IFS= read -r ans < /dev/tty || ans=""
  fi
  ans="${ans:-$default}"
  local tok
  for tok in $allowed; do
    if [[ "$ans" == "$tok" ]]; then
      printf '%s\n' "$ans"
      return
    fi
  done
  printf '%s\n' "$default"
}

summary_and_exit() {
  local code="$1"
  printf '\n%s======== SUMMARY ========%s\n' "$BOLD" "$RST"
  if ((${#PASS[@]})); then
    printf '%sPASS%s (%d)\n' "$GRN" "$RST" "${#PASS[@]}"
    printf '  - %s\n' "${PASS[@]}"
  fi
  if ((${#SKIP[@]})); then
    printf '%sSKIP%s (%d)\n' "$YLW" "$RST" "${#SKIP[@]}"
    printf '  - %s\n' "${SKIP[@]}"
  fi
  if ((${#FAIL[@]})); then
    printf '%sFAIL%s (%d)\n' "$RED" "$RST" "${#FAIL[@]}"
    printf '  - %s\n' "${FAIL[@]}"
  fi
  if [[ "$code" -ne 0 ]]; then
    printf '\n%ssetup failed%s — fix the FAIL lines and rerun ./setup\n' "$RED" "$RST"
    dim "Python 3.12 recipes: README → Install → Python 3.12"
    exit "$code"
  fi

  printf '\n%s======== INSTALL COMPLETE ========%s\n' "$GRN" "$RST"
  printf '\n'
  printf '  venv      %s\n' "$ROOT/.venv"
  printf '  python    %s\n' "$(.venv/bin/python -c 'import sys; print(sys.version.split()[0])' 2>/dev/null || echo '?')"
  printf '  activate  %ssource .venv/bin/activate%s\n' "$BOLD" "$RST"
  printf '\n'
  printf '  %sNext%s\n' "$BOLD" "$RST"
  printf '    source .venv/bin/activate\n'
  if [[ -f checkpoints/sudoku-extreme/checkpoint ]]; then
    printf '    python scripts/smoke_test_inference.py    # Sudoku ACT (rerun anytime)\n'
  else
    printf '    python scripts/fetch_checkpoints.py --only sudoku-extreme\n'
    printf '    python scripts/smoke_test_inference.py\n'
  fi
  if [[ -f checkpoints/ARC-2/checkpoint && -f checkpoints/maze-30x30-hard/checkpoint ]]; then
    printf '    python scripts/smoke_test_all.py          # Maze + ARC-2\n'
  else
    printf '    python scripts/fetch_checkpoints.py       # Maze + ARC-2 (~2.2 GiB more)\n'
    printf '    python scripts/smoke_test_all.py\n'
  fi
  printf '    docs/environment.md                       # device policy, disk\n'
  printf '    docs/compute.md                           # Twin-T4 harvest\n'
  printf '\n'
  dim "There is no routing head yet. Stage 2 is not this install."
  exit 0
}

die_stage() {
  bad "$1"
  summary_and_exit 1
}

is_py312() {
  local bin="$1"
  [[ -n "$bin" && -x "$bin" ]] || return 1
  "$bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null
}

resolve_bin() {
  local c="$1"
  [[ -n "$c" ]] || return 1
  if [[ -x "$c" ]]; then
    printf '%s\n' "$c"
    return 0
  fi
  command -v "$c" 2>/dev/null
}

record_too_old() {
  local path="$1"
  [[ -n "$path" && -x "$path" ]] || return 0
  TOO_OLD_PATH="$path"
  TOO_OLD_VER="$("$path" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || echo unknown)"
}

find_python() {
  local cand path brew_py=""
  if command -v brew >/dev/null 2>&1; then
    brew_py="$(brew --prefix python@3.12 2>/dev/null)/bin/python3.12" || brew_py=""
  fi
  for cand in \
      "${HRM_GEARS_PYTHON:-}" \
      "${PYTHON:-}" \
      python3.12 \
      "$brew_py" \
      /opt/homebrew/Caskroom/miniforge/base/bin/python3.12 \
      /opt/homebrew/opt/python@3.12/bin/python3.12 \
      /usr/local/opt/python@3.12/bin/python3.12 \
      python3
  do
    path="$(resolve_bin "$cand" || true)"
    [[ -n "$path" ]] || continue
    if is_py312 "$path"; then
      printf '%s\n' "$path"
      return 0
    fi
    record_too_old "$path"
  done
  return 1
}

mem_bytes() {
  if [[ -r /proc/meminfo ]]; then
    awk '/MemAvailable:/ {printf "%.0f\n", $2 * 1024; exit}' /proc/meminfo
  elif [[ "$(uname -s)" == Darwin ]]; then
    sysctl -n hw.memsize 2>/dev/null || echo 0
  else
    echo 0
  fi
}

# ---------------------------------------------------------------------------
printf '%s\n' "${BOLD}hrm-gears setup${RST}"
if [[ "$NONINTERACTIVE" -eq 1 ]]; then
  dim "Door 1 — unattended (--yes / Docker / CI)"
else
  dim "Door 1 — interactive install. Commands are printed before they run."
  dim "Ctrl-C aborts. Defaults are in [brackets]."
fi
dim "repo $ROOT"

# ---------------------------------------------------------------------------
stage 1 "environment (Python, platform, disk, accelerator)"

uname_s="$(uname -s)"
uname_m="$(uname -m)"
say "  platform  ${uname_s}/${uname_m}"

PYTHON_BIN="$(find_python || true)"
if [[ -n "$PYTHON_BIN" ]]; then
  py_ver="$("$PYTHON_BIN" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])')"
  ok "python ${py_ver} (${PYTHON_BIN})"
else
  if [[ -n "$TOO_OLD_PATH" ]]; then
    say "  found     Python ${TOO_OLD_VER} at ${TOO_OLD_PATH}  (need >= 3.12)"
  else
    say "  found     no python3 on PATH"
  fi

  install_kind=""
  install_notes=()
  if command -v uv >/dev/null 2>&1; then
    install_kind="uv"
    install_notes=("uv python install 3.12")
  elif [[ "$uname_s" == Darwin ]] && command -v brew >/dev/null 2>&1; then
    install_kind="brew"
    install_notes=("brew install python@3.12")
  elif command -v apt-get >/dev/null 2>&1; then
    install_kind="apt"
    install_notes=("sudo apt-get update" "sudo apt-get install -y python3.12 python3.12-venv")
  elif command -v curl >/dev/null 2>&1; then
    install_kind="uv-bootstrap"
    install_notes=(
      "curl -LsSf https://astral.sh/uv/install.sh | sh"
      "uv python install 3.12"
    )
  fi

  if [[ -z "$install_kind" ]]; then
    die_stage "Python 3.12 is missing and no installer is available (need brew, apt, uv, or curl)"
  fi

  say "  Python 3.12 is missing. Install with ${install_kind}?"
  for line in "${install_notes[@]}"; do
    dim "  $line"
  done

  if ! ask_yn "Python 3.12 is missing. Install?" Y; then
    die_stage "Python 3.12 is missing — declined install (README: Python 3.12)"
  fi

  say "  running install…"
  case "$install_kind" in
    uv)
      uv python install 3.12
      export PATH="$(dirname "$(uv python find 3.12)"):${PATH}"
      ;;
    brew)
      brew install python@3.12
      export PATH="$(brew --prefix python@3.12)/bin:${PATH}"
      ;;
    apt)
      sudo apt-get update
      sudo apt-get install -y python3.12 python3.12-venv
      ;;
    uv-bootstrap)
      curl -LsSf https://astral.sh/uv/install.sh | sh
      export PATH="${HOME}/.local/bin:${PATH}"
      if [[ -f "${HOME}/.local/bin/env" ]]; then
        # shellcheck disable=SC1091
        source "${HOME}/.local/bin/env"
      fi
      command -v uv >/dev/null 2>&1 || die_stage "uv install finished but 'uv' is not on PATH"
      uv python install 3.12
      export PATH="$(dirname "$(uv python find 3.12)"):${PATH}"
      ;;
  esac

  PYTHON_BIN="$(find_python || true)"
  [[ -n "$PYTHON_BIN" ]] || die_stage "Python 3.12 install ran but probe still failed"
  py_ver="$("$PYTHON_BIN" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])')"
  ok "python ${py_ver} (${PYTHON_BIN})  [installed]"
fi

export PYTHON="$PYTHON_BIN"

avail="$("$PYTHON_BIN" -c 'import os, shutil; print(shutil.disk_usage(".").free)')"
avail_h="$("$PYTHON_BIN" -c "print(f'{$avail/1024**3:.1f} GiB')")"
mem="$(mem_bytes)"
mem_h="unknown"
if [[ "$mem" -gt 0 ]]; then
  mem_h="$("$PYTHON_BIN" -c "print(f'{$mem/1024**3:.1f} GiB')")"
fi
say "  disk      ${avail_h} free (want >= 8 GiB for all three checkpoints; ~0.6 GiB for Sudoku only)"
say "  memory    ${mem_h} available"

if [[ "$avail" -lt "$sudoku_bytes" ]]; then
  die_stage "disk free ${avail_h}; need at least ~0.6 GiB"
fi
if [[ "$avail" -lt "$need_bytes" ]]; then
  say "  ${YLW}under 8 GiB free${RST} — all-three fetch may not fit. Sudoku-only is the safe default."
  if [[ "$WANT_SUDOKU_ONLY" -eq 0 && "$NONINTERACTIVE" -eq 0 ]]; then
    if ask_yn "Continue with Sudoku-only weights (~104 MiB)?" Y; then
      FETCH_SET="sudoku"
      WANT_SUDOKU_ONLY=1
    else
      die_stage "disk free ${avail_h}; want >= 8 GiB for venv + three checkpoints"
    fi
  elif [[ "$NONINTERACTIVE" -eq 1 && "$WANT_SUDOKU_ONLY" -eq 0 ]]; then
    die_stage "disk free ${avail_h}; want >= 8 GiB (pass --sudoku for the small set)"
  fi
fi
ok "disk ${avail_h} free"

ACCEL="cpu"
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
  ACCEL="cuda"
  ok "nvidia-smi present (CUDA lane)"
else
  dim "nvidia-smi not present — CUDA is optional. MPS/CPU is the M4 path."
fi
if [[ "$uname_s" == Darwin && "$uname_m" == arm64 ]]; then
  ok "Apple Silicon — MPS expected after torch install"
  ACCEL_HINT="mps"
else
  ACCEL_HINT="$ACCEL"
fi
say "  accel     ${ACCEL_HINT}"
if [[ "$ACCEL_HINT" == cpu && "$WANT_SUDOKU_ONLY" -eq 0 && "$mem" -gt 0 && "$mem" -lt $((8 * 1024 * 1024 * 1024)) ]]; then
  dim "ARC-2 smoke wants ~3.5 GiB RSS. This box looks tight; Sudoku-only is safer."
  if [[ "$NONINTERACTIVE" -eq 0 ]]; then
    if ask_yn "Prefer Sudoku-only checkpoints on this box?" Y; then
      FETCH_SET="sudoku"
      WANT_SUDOKU_ONLY=1
    fi
  fi
fi

# ---------------------------------------------------------------------------
stage 2 "venv"

if [[ -x .venv/bin/python ]]; then
  venv_ok=0
  if is_py312 .venv/bin/python; then venv_ok=1; fi
  venv_ver="$(.venv/bin/python -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || echo unknown)"
  if [[ "$venv_ok" -eq 1 ]]; then
    ok "reusing .venv (python ${venv_ver})"
  else
    say "  .venv is Python ${venv_ver} — need >= 3.12"
    if ask_yn "Recreate .venv with ${py_ver}?" Y; then
      rm -rf .venv
      say "  creating .venv with ${PYTHON_BIN}"
      "$PYTHON_BIN" -m venv .venv || die_stage "venv create failed"
      ok "created .venv"
    else
      die_stage ".venv is Python ${venv_ver}; declined recreate"
    fi
  fi
else
  say "  creating .venv with ${PYTHON_BIN}"
  dim "python -m venv .venv"
  "$PYTHON_BIN" -m venv .venv || die_stage "venv create failed"
  ok "created .venv"
fi
# shellcheck disable=SC1091
source .venv/bin/activate
ok "venv python $(python -c 'import sys; print(sys.version.split()[0])')"

# ---------------------------------------------------------------------------
stage 3 "packages (torch, requirements, SDPA flash_attn shim)"

dim "./scripts/bootstrap_env.sh"
dim "installs torch + requirements.txt into .venv; writes hrm_gears_flash_attn.pth"
if ! ./scripts/bootstrap_env.sh; then
  die_stage "bootstrap_env.sh"
fi
ok "bootstrap_env.sh"

# ---------------------------------------------------------------------------
stage 4 "checkpoints (Hugging Face; gitignored)"

if [[ "$FETCH_SET" == all && "$WANT_SUDOKU_ONLY" -eq 1 ]]; then
  FETCH_SET="sudoku"
fi

if [[ "$NONINTERACTIVE" -eq 0 && "$WANT_SUDOKU_ONLY" -eq 0 ]]; then
  dim "Sudoku ~104 MiB. Maze ~104 MiB. ARC-2 ~2.1 GiB (puzzle-id table; ~3.5 GiB RSS)."
  dim "Weights are Sapient's; we fetch, we do not vendor."
  choice="$(ask_choice "Checkpoints: [1] Sudoku only  [2] all three  [3] skip" "2" 1 2 3)"
  case "$choice" in
    1) FETCH_SET="sudoku" ;;
    3) FETCH_SET="skip" ;;
    *) FETCH_SET="all" ;;
  esac
fi

have_sudoku=0 have_maze=0 have_arc=0
[[ -f checkpoints/sudoku-extreme/checkpoint ]] && have_sudoku=1
[[ -f checkpoints/maze-30x30-hard/checkpoint ]] && have_maze=1
[[ -f checkpoints/ARC-2/checkpoint ]] && have_arc=1

case "$FETCH_SET" in
  skip)
    warn "checkpoint fetch skipped"
    ;;
  sudoku)
    if [[ "$have_sudoku" -eq 1 ]]; then
      ok "sudoku-extreme already on disk"
    else
      say "  fetching sapientinc/HRM-checkpoint-sudoku-extreme"
      dim "unauthenticated Hub is fine; HF_TOKEN raises rate limits"
      if ! python scripts/fetch_checkpoints.py --only sudoku-extreme; then
        die_stage "fetch_checkpoints.py (sudoku-extreme)"
      fi
      ok "fetched sudoku-extreme"
    fi
    ;;
  all)
    if [[ "$have_sudoku" -eq 1 && "$have_maze" -eq 1 && "$have_arc" -eq 1 ]]; then
      ok "checkpoints already on disk (sudoku / maze / ARC-2)"
    else
      say "  fetching all three sapientinc HRM checkpoints"
      dim "unauthenticated Hub is fine; HF_TOKEN raises rate limits"
      if ! python scripts/fetch_checkpoints.py; then
        die_stage "fetch_checkpoints.py"
      fi
      ok "fetch_checkpoints.py"
    fi
    ;;
esac

# ---------------------------------------------------------------------------
stage 5 "Sudoku ACT smoke"

if [[ ! -f checkpoints/sudoku-extreme/checkpoint ]]; then
  warn "Sudoku smoke skipped (no checkpoint)"
elif [[ "$NONINTERACTIVE" -eq 0 ]]; then
  if ask_yn "Run Sudoku ACT smoke now?" Y; then
    if ! python scripts/smoke_test_inference.py; then
      die_stage "smoke_test_inference.py (Sudoku)"
    fi
    ok "Sudoku smoke"
  else
    warn "Sudoku smoke skipped"
  fi
else
  if ! python scripts/smoke_test_inference.py; then
    die_stage "smoke_test_inference.py (Sudoku)"
  fi
  ok "Sudoku smoke"
fi

# ---------------------------------------------------------------------------
stage 6 "Maze + ARC-2 smoke"

if [[ "$FETCH_SET" == sudoku || "$FETCH_SET" == skip ]]; then
  warn "Maze + ARC-2 smoke skipped (Sudoku-only / no weights)"
elif [[ ! -f checkpoints/maze-30x30-hard/checkpoint || ! -f checkpoints/ARC-2/checkpoint ]]; then
  warn "Maze + ARC-2 smoke skipped (weights missing)"
elif [[ "$NONINTERACTIVE" -eq 0 ]]; then
  dim "ARC-2 loads a ~2.1 GiB embedding table. OOM on small boxes is a skip, not a mystery."
  if ask_yn "Run Maze + ARC-2 smoke now?" Y; then
    if ! python scripts/smoke_test_all.py; then
      die_stage "smoke_test_all.py (Maze + ARC-2)"
    fi
    ok "Maze + ARC-2 smoke"
  else
    warn "Maze + ARC-2 smoke skipped"
  fi
else
  if ! python scripts/smoke_test_all.py; then
    die_stage "smoke_test_all.py (Maze + ARC-2)"
  fi
  ok "Maze + ARC-2 smoke"
fi

summary_and_exit 0
